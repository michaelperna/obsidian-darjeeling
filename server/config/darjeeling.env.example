# Project Darjeeling server configuration
# Installed to /etc/darjeeling/darjeeling.env (mode 0640, root:darjeeling)
#
# Changes require restarting the service:
#   sudo systemctl restart darjeeling.service

# Network bind address.
# Leave unset or commented out for automatic overlay detection (Tailscale -> Meshnet -> Wireguard -> LAN -> Loopback).
# To bind to a specific address, uncomment and set:
# DARJEELING_BIND=127.0.0.1
# (DARJEELING_HOST is supported as an alias for backwards compatibility)
# DARJEELING_HOST=127.0.0.1

# TCP listen port (default: 8765)
DARJEELING_PORT=8765

# Default terminal session name
DARJEELING_SESSION=darjeeling

# Dedicated tmux socket name (used by darjeeling-tmux.service)
DARJEELING_TMUX_SOCKET=darjeeling

# Obsidian vault root directory on the server
DARJEELING_VAULT=/var/lib/darjeeling/vault

# State directory for token, pairing devices, and runfiles
DARJEELING_STATE_DIR=/var/lib/darjeeling

# Path to the shared token file (mode 0600)
DARJEELING_TOKEN_FILE=/var/lib/darjeeling/.token

# Maximum duration (in seconds) for a single agent turn (default: 1800)
DARJEELING_TURN_TIMEOUT=1800

# Concurrency limit for simultaneous agent turns.
# Default is 2 (automatically capped at 1 on systems with < 4 GB RAM)
DARJEELING_MAX_CONCURRENT_TURNS=2

# Highest permission mode a client may request for an agent turn. Requests
# above the ceiling are lowered to it.
# Values (lowest to highest):
#   plan               read-only analysis, no file edits
#   acceptEdits        may edit files in the vault/workspace (default)
#   bypassPermissions  runs tools and shell commands without asking
# Raise it with: sudo darjeeling config set permission-ceiling bypassPermissions
# then: sudo systemctl restart darjeeling.service
DARJEELING_PERMISSION_CEILING=acceptEdits

# Set to 1 to enable uvicorn HTTP access logging in journald (default: 0)
DARJEELING_ACCESS_LOG=0

# Vault synchronization mode: none, obsidian-sync
DARJEELING_VAULT_SYNC=none

# Optional: DeepSeek API configuration (direct HTTPS API agent)
# Keep the API key out of this file. Store it with:
#   sudo darjeeling config set deepseek-api-key
# which writes /var/lib/darjeeling/secrets/deepseek_api_key (0600, service user).
# DEEPSEEK_API_KEY in this file still works as a fallback.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
