# Darjeeling lab CI image: Node 22 (plugin build) + Python 3.11 (server) +
# tmux (terminal tests) + shellcheck. Built and cached on the lab host by
# scripts/lab/lib/host-ci.sh; rebuilt only when this file changes.
ARG BASE=docker.io/library/node:22-bookworm
FROM ${BASE}
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      python3 python3-venv python3-pip tmux shellcheck procps zip \
 && apt-get clean && rm -rf /var/lib/apt/lists/*
ENV npm_config_update_notifier=false \
    npm_config_fund=false \
    npm_config_audit=false \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    LANG=C.UTF-8
WORKDIR /work
