# Darjeeling Vault Sync test image: runs isolated Syncthing instances in container
FROM docker.io/library/debian:13-slim
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      syncthing python3 procps ca-certificates curl \
 && apt-get clean && rm -rf /var/lib/apt/lists/*
WORKDIR /work
