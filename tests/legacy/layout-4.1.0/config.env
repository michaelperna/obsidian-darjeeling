# Bind to the Meshnet interface only. 0.0.0.0 exposed this on every network
# the laptop joined.
DARJEELING_HOST=127.0.0.1
DARJEELING_PORT=8765
DARJEELING_SESSION=darjeeling
DARJEELING_VAULT=/home/darjeeling/vault
DARJEELING_ARTIFACTS=/home/darjeeling/vault/_darjeeling
DARJEELING_TOKEN=placeholder-legacy-token-for-test-matrix-32chars
DARJEELING_TURN_TIMEOUT=1800

# DeepSeek is an API agent, not a CLI -- set this to enable it.
# DEEPSEEK_API_KEY=placeholder-deepseek-key
